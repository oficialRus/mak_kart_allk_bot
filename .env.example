# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-domain.com/mini_app

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mak_kart_bot
DB_SSLMODE=disable

# OpenAI (для ИИ-психолога)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# App
APP_ENV=development
