# Секрет для HMAC хэша OTP (минимум 32 случайных байта в base64/hex или длинная строка).
EMAIL_OTP_SECRET=замените_на_случайную_длинную_строку

# --- Рекомендуется для доставки на @mail.ru / Gmail: Resend (HTTPS), без своего SMTP ---
# Регистрация: https://resend.com — ключ re_..., подтвердите домен или используйте тестовый from с их инструкции.
# Если задан RESEND_API_KEY, он ВАЖНЕЕ обычного SMTP.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Гармония <otp@ваш-подтверждённый-домен.ru>
# (если RESEND_FROM пусто — берётся SMTP_FROM)

# --- Отправка через почту Mail.ru (если ящик ruslan.oficial@mail.ru ваш) ---
# В настройках Mail.ru включите SMTP и пароль для внешних приложений.
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=ruslan.oficial@mail.ru
# SMTP_PASSWORD=пароль_приложения_mail_ru
# SMTP_FROM=ruslan.oficial@mail.ru
# (порт 465 — автоматически SSL; SMTP_FROM должен совпадать с SMTP_USER)

# Локальная отладка: логировать код вместо SMTP (1 / true).
# EMAIL_OTP_DEV_LOG=1

# Код в Telegram по умолчанию ВЫКЛЮЧЕН — только на email (Resend/SMTP).
# Запасной канал Telegram, если письмо не отправилось:
# EMAIL_OTP_TELEGRAM_FALLBACK=1
# Дублировать код в Telegram при успешной почте (для SMTP/Resend):
# EMAIL_OTP_ALSO_TELEGRAM=1
# Полностью запретить Telegram:
# EMAIL_OTP_DISABLE_TELEGRAM=1

# SMTP. Если HOST+FROM не заданы, код всё равно создаётся и пишется в ЛОГ сервера (письма не будет).
# Чтобы без SMTP получать ошибку 502 — EMAIL_OTP_STRICT_SMTP=1
# EMAIL_OTP_STRICT_SMTP=1
SMTP_HOST=smtp.example.com
# 587 — STARTTLS (по умолчанию SMTP_USE_TLS не 0). 465 — сразу SSL (включится автоматически).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# 0 — без STARTTLS (редко)
# SMTP_USE_TLS=1
# Принудительно «сразу TLS» на нестандартном порту:
# SMTP_IMPLICIT_TLS=1

# Сессия кабинета после verify (opaque token в БД — хэш). По умолчанию pepper = EMAIL_OTP_SECRET или производное от BOT_TOKEN.
# CABINET_SESSION_SECRET=отдельная_длинная_строка_опционально
# Срок жизни сессии в сутках (по умолчанию 30):
# CABINET_SESSION_DAYS=30

# Уже есть в проекте: BOT_TOKEN, DB_*, API_PORT
#
# Кабинет по email без Telegram: клиент шлёт cabinetDeviceId (UUID в localStorage).
# Если передан валидный initData, приоритет у Telegram-пользователя.
#
# Код входа в кабинет из Mini App: дублируется в ЛС Telegram бота (BOT_TOKEN тот же, что у бота).
# Пользователь должен хотя бы раз написать боту /start.
